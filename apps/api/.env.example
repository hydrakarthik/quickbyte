# Copy to apps/api/.env and adjust. .env is gitignored; never commit real secrets.

# development | test | production (default: development)
NODE_ENV=development

# Interface and port the HTTP server binds to (defaults: 0.0.0.0, 3000; port 1-65535)
HOST=0.0.0.0
PORT=3000

# fatal | error | warn | info | debug | trace | silent (default: info)
LOG_LEVEL=info

# Required. Must start with mongodb:// or mongodb+srv://
MONGODB_URI=mongodb://localhost:27017/quickbyte

# MongoDB server selection timeout in ms, 100-60000 (default: 5000)
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# Graceful shutdown timeout in ms, 1000-120000 (default: 10000)
SHUTDOWN_TIMEOUT_MS=10000
